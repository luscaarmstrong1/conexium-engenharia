---
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "";
---

<section
  class="fixed inset-x-4 bottom-4 z-40 mx-auto hidden max-w-2xl rounded-[8px] border border-white/10 bg-[#001F1A]/95 p-4 text-[#F7F4EC] shadow-2xl backdrop-blur-md font-sans-tech"
  aria-live="polite"
  data-cookie-banner
  data-ga-id={gaId}
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-xs leading-relaxed text-[#F7F4EC]/85">
      Utilizamos cookies essenciais para o funcionamento e analytics anônimo mediante seu consentimento prévio.
    </p>
    <div class="flex shrink-0 gap-2.5">
      <button type="button" class="rounded border border-white/20 px-3.5 py-1.5 text-xs font-medium text-white transition hover:bg-white/10" data-cookie-decline>Recusar</button>
      <button type="button" class="rounded bg-[#C79A3B] px-4 py-1.5 text-xs font-semibold text-[#001F1A] transition hover:bg-[#D8AD4F]" data-cookie-accept>Aceitar</button>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  const banner = document.querySelector("[data-cookie-banner]");
  const consent = localStorage.getItem("conexium-cookie-consent");
  const gaId = banner?.getAttribute("data-ga-id");

  function startAnalytics() {
    if (!gaId || document.querySelector(`[src*="${gaId}"]`)) return;
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(script);
    window.dataLayer = window.dataLayer || [];
    function gtag(...args) {
      window.dataLayer.push(args);
    }
    window.gtag = gtag;
    gtag("js", new Date());
    gtag("config", gaId, { anonymize_ip: true });
  }

  if (!consent) banner?.classList.remove("hidden");
  if (consent === "accepted") startAnalytics();

  document.querySelector("[data-cookie-accept]")?.addEventListener("click", () => {
    localStorage.setItem("conexium-cookie-consent", "accepted");
    banner?.classList.add("hidden");
    startAnalytics();
  });

  document.querySelector("[data-cookie-decline]")?.addEventListener("click", () => {
    localStorage.setItem("conexium-cookie-consent", "declined");
    banner?.classList.add("hidden");
  });
</script>
