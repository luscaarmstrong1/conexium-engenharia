---
import { navItems, site } from "@data/site";
import { withBase } from "@lib/urls";

const linkedin = import.meta.env.PUBLIC_LINKEDIN_URL || "https://www.linkedin.com/company/conexium-engenharia";
---

<footer class="border-t border-white/[0.08] bg-[#001613] text-[#F7F4ED]/80">
  <div class="cx-shell pt-[50px] pb-[28px]">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
      <!-- Logo com 160px -->
      <a href={withBase("/")} aria-label={`${site.name} - Página inicial`}>
        <img src={withBase("/brand/conexium-logo-white.svg")} alt={site.name} class="h-9 w-auto max-w-[160px]" width="160" height="36" />
      </a>

      <!-- Links com 14px -->
      <nav class="flex flex-wrap items-center justify-center gap-7 text-[14px]" aria-label="Links do rodapé">
        {navItems.map((item) => (
          <a href={withBase(item.href)} class="transition hover:text-white">{item.label}</a>
        ))}
      </nav>

      <!-- Contato e Redes -->
      <div class="flex flex-wrap items-center gap-6 text-[14px]">
        <a href={`tel:${site.phone.replace(/\D/g, '')}`} class="flex items-center gap-2 text-white/90 transition hover:text-[#DEA945]">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DEA945" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>{site.phoneDisplay}</span>
        </a>
        <a href={`mailto:${site.email}`} class="flex items-center gap-2 text-white/90 transition hover:text-[#DEA945]">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DEA945" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <span>{site.email}</span>
        </a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center text-white/90 transition hover:text-[#DEA945]" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.92 0 1.66-.74 1.66-1.66s-.74-1.66-1.66-1.66-1.66.74-1.66 1.66.74 1.66 1.66 1.66m1.39 9.74v-8.37H5.07v8.37h2.78z"></path></svg>
        </a>
      </div>
    </div>

    <!-- Linha de direitos e políticas -->
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/[0.06] pt-6 text-[12px] text-[#747C78] md:flex-row">
      <p>© 2026 Conexium Engenharia. Todos os direitos reservados.</p>
      <div class="flex items-center gap-6">
        <a href={withBase("/politica-de-privacidade/")} class="transition hover:text-white">Política de Privacidade</a>
        <span>|</span>
        <a href={withBase("/politica-de-cookies/")} class="transition hover:text-white">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
