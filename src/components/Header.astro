---
import { navItems, site } from "@data/site";
import { withBase } from "@lib/urls";

type Props = { currentPath: string };
const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(href);
}
---

<header class="sticky inset-x-0 top-0 z-50 h-[76px] border-b border-white/[0.06] bg-[#001F1A]/90 text-white backdrop-blur-[14px] transition-all duration-300" data-site-header>
  <div class="cx-shell flex h-full items-center justify-between">
    <!-- Brand Logo: Assinatura Oficial Conexium Engenharia -->
    <a href={withBase("/")} class="flex items-center" aria-label={`${site.name} - Página inicial`}>
      <img src={withBase("/brand/logo-conexium-white.png")} alt={site.name} class="h-8 md:h-9 w-auto object-contain max-w-[190px] md:max-w-[210px]" width="210" height="70" />
    </a>

    <!-- Desktop Nav: Início | Quem somos | Serviços | Casos e insights | Contato com gap rigoroso -->
    <nav class="hidden items-center gap-[32px] lg:gap-[38px] md:flex" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "relative text-[13.5px] font-medium tracking-[0.01em] transition-colors hover:text-white",
            isActive(item.href) ? "text-white font-semibold" : "text-[#A7ACA8] hover:text-[#F7F4EC]",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
          {isActive(item.href) && (
            <span class="absolute -bottom-2 left-0 h-[2px] w-full rounded-full bg-[#C79A3B]" aria-hidden="true" />
          )}
        </a>
      ))}
    </nav>

    <!-- Header CTA: 42px de altura, presença premium -->
    <div class="hidden items-center md:flex">
      <a
        href={withBase("/contato/")}
        class="btn-header-cta"
        data-track="cta-header"
      >
        Solicitar diagnóstico <span class="ml-1.5" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      type="button"
      class="grid h-10 w-10 place-items-center rounded-md border border-white/15 bg-white/5 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
      data-menu-button
    >
      <span class="h-3.5 w-4 border-y border-white/80" data-menu-icon-open aria-hidden="true"></span>
      <span class="hidden text-xl leading-none text-white" data-menu-icon-close aria-hidden="true">&times;</span>
    </button>
  </div>

  <!-- Mobile Nav Panel -->
  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-[#042923] px-6 pb-6 pt-4 shadow-2xl md:hidden" aria-label="Navegação móvel" data-mobile-menu>
    <div class="flex flex-col gap-2.5">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "rounded-md px-3 py-2.5 text-sm font-medium transition",
            isActive(item.href) ? "bg-[#08332C] text-[#C79A3B]" : "text-white/80 hover:bg-white/5 hover:text-white",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href={withBase("/contato/")} class="btn-gold mt-3 text-center">
        Solicitar diagnóstico →
      </a>
    </div>
  </nav>
</header>

<script>
  // @ts-nocheck
  const header = document.querySelector("[data-site-header]");
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector("[data-menu-icon-open]");
  const closeIcon = document.querySelector("[data-menu-icon-close]");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      header?.classList.add("bg-[#001F1A]/98", "shadow-md");
      header?.classList.remove("bg-[#001F1A]/90");
    } else {
      header?.classList.remove("bg-[#001F1A]/98", "shadow-md");
      header?.classList.add("bg-[#001F1A]/90");
    }
  }, { passive: true });

  function setMenu(open) {
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    menu?.classList.toggle("hidden", !open);
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  button?.addEventListener("click", () => setMenu(button.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  document.addEventListener("click", (event) => {
    if (button?.getAttribute("aria-expanded") === "true" && header && !header.contains(event.target)) setMenu(false);
  });
</script>
