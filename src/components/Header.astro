---
import { navItems, site } from "@data/site";
import { withBase } from "@lib/urls";

type Props = { currentPath: string };
const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(href);
}
---

<header class="sticky inset-x-0 top-0 z-50 h-[80px] border-b border-white/10 bg-[#001816]/90 text-white backdrop-blur-md transition-colors" data-site-header>
  <div class="cx-shell flex h-full items-center justify-between">
    <!-- Brand Logo -->
    <a href={withBase("/")} class="flex items-center gap-3" aria-label={`${site.name} - Página inicial`}>
      <img src={withBase("/brand/conexium-logo-white.svg")} alt={site.name} class="h-10 w-auto" width="220" height="40" />
    </a>

    <!-- Desktop Nav: Início | Quem somos | Serviços | Casos e insights | Contato -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "relative text-sm font-medium transition-colors hover:text-white",
            isActive(item.href) ? "text-white" : "text-[#D8D8D5]/80",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
          {isActive(item.href) && (
            <span class="absolute -bottom-2 left-0 h-[2px] w-full rounded-full bg-[#E6B64C]" aria-hidden="true" />
          )}
        </a>
      ))}
    </nav>

    <!-- Header Action: Solicitar diagnóstico -->
    <div class="hidden items-center md:flex">
      <a
        href={withBase("/contato/")}
        class="btn-gold"
        data-track="cta-header"
      >
        Solicitar diagnóstico <span class="ml-1.5" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="grid h-10 w-10 place-items-center rounded-md border border-white/15 bg-white/5 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menu"
      data-menu-button
    >
      <span class="h-3.5 w-4 border-y border-white/80" data-menu-icon-open aria-hidden="true"></span>
      <span class="hidden text-xl leading-none text-white" data-menu-icon-close aria-hidden="true">&times;</span>
    </button>
  </div>

  <!-- Mobile Nav Panel -->
  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-[#001D1B] px-5 pb-6 pt-4 shadow-2xl md:hidden" aria-label="Navegação móvel" data-mobile-menu>
    <div class="flex flex-col gap-2">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            "rounded-md px-3 py-2.5 text-sm font-medium transition",
            isActive(item.href) ? "bg-[#002825] text-[#E6B64C]" : "text-white/80 hover:bg-white/5 hover:text-white",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href={withBase("/contato/")} class="btn-gold mt-3 text-center">
        Solicitar diagnóstico →
      </a>
    </div>
  </nav>
</header>

<script>
  // @ts-nocheck
  const header = document.querySelector("[data-site-header]");
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector("[data-menu-icon-open]");
  const closeIcon = document.querySelector("[data-menu-icon-close]");

  function setMenu(open) {
    button?.setAttribute("aria-expanded", String(open));
    button?.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    menu?.classList.toggle("hidden", !open);
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  button?.addEventListener("click", () => setMenu(button.getAttribute("aria-expanded") !== "true"));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  document.addEventListener("click", (event) => {
    if (button?.getAttribute("aria-expanded") === "true" && header && !header.contains(event.target)) setMenu(false);
  });
</script>
