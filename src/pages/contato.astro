---
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactForm from "@components/ContactForm.astro";
import { site } from "@data/site";
---

<BaseLayout
  title="Contato | Conexium Engenharia"
  description="Entre em contato com a Conexium Engenharia para solicitar uma avaliação técnica especializada em engenharia elétrica, regulação ou perícias."
  path="/contato/"
>
  <!-- Hero Section -->
  <section class="border-b border-white/10 bg-[#001816] py-16 text-white">
    <div class="cx-shell">
      <p class="text-xs font-bold tracking-[0.2em] text-[#E6B64C] uppercase">
        CANAIS DE ATENDIMENTO
      </p>
      <h1 class="font-serif-display mt-3 text-[clamp(2.2rem,3.4vw,3.2rem)] text-white leading-tight">
        Fale com um especialista
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-[#D8D8D5]/90">
        Apresente sua demanda para avaliação técnica. Atendemos empresas, integradores, investidores, escritórios e agentes do setor elétrico.
      </p>
    </div>
  </section>

  <!-- Form and Direct Channels -->
  <section class="bg-[#FAF8F3] py-20 text-[#303735]">
    <div class="cx-shell">
      <div class="grid gap-12 lg:grid-cols-[40%_60%]">
        <!-- Direct Channels -->
        <div>
          <h2 class="font-serif-display text-2xl text-[#001816]">
            Canais Diretos
          </h2>
          <p class="mt-3 text-xs leading-relaxed text-[#303735]/80">
            Nossa equipe técnica analisa solicitações com rigor e sigilo profissional.
          </p>

          <div class="mt-8 space-y-6">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-[#D8D8D5] text-[#D7A536]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#8D9592]">Telefone / WhatsApp</p>
                <a href={`tel:${site.phone.replace(/\D/g, '')}`} class="mt-1 block text-sm font-semibold text-[#001816] hover:text-[#D7A536]">
                  {site.phoneDisplay}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-[#D8D8D5] text-[#D7A536]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#8D9592]">E-mail Corporativo</p>
                <a href={`mailto:${site.email}`} class="mt-1 block text-sm font-semibold text-[#001816] hover:text-[#D7A536]">
                  {site.email}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white border border-[#D8D8D5] text-[#D7A536]">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-[#8D9592]">Atuação Técnica Nacional</p>
                <p class="mt-1 text-xs text-[#303735]">
                  Atendimento especializado em processos e análises para todo o território brasileiro.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Component -->
        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
