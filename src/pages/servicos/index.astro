---
import BaseLayout from "@layouts/BaseLayout.astro";
import { servicePages } from "@data/site";
import { withBase } from "@lib/urls";
---

<BaseLayout
  title="Soluções Técnicas | Conexium Engenharia"
  description="Engenharia, regulação e evidência técnica aplicadas a projetos, processos e decisões do setor elétrico."
  path="/servicos/"
>
  <!-- Hero Section -->
  <section class="border-b border-white/10 bg-[#001816] py-20 text-white">
    <div class="cx-shell">
      <p class="text-xs font-bold tracking-[0.2em] text-[#E6B64C] uppercase">
        CONEXIUM ENGENHARIA
      </p>
      <h1 class="font-serif-display mt-4 text-[clamp(2.4rem,3.6vw,3.6rem)] text-white leading-tight">
        Soluções técnicas
      </h1>
      <p class="mt-4 max-w-2xl text-base text-[#D8D8D5]/90 leading-relaxed">
        Engenharia, regulação e evidência técnica aplicadas a projetos, processos e decisões do setor elétrico.
      </p>
    </div>
  </section>

  <!-- 3 Pilares Principais -->
  <section class="bg-[#001D1B] py-20 text-white">
    <div class="cx-shell space-y-16">
      {servicePages.map((service, index) => (
        <article class="grid items-center gap-10 rounded-xl border border-white/10 bg-[#002320] p-6 lg:grid-cols-2 lg:p-10">
          <div class={index % 2 === 1 ? "lg:order-2" : ""}>
            <p class="text-xs font-bold tracking-widest text-[#E6B64C] uppercase">
              {service.eyebrow}
            </p>
            <h2 class="font-serif-display mt-3 text-2xl lg:text-3xl text-white">
              {service.title}
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-[#D8D8D5]/90">
              {service.cardDescription}
            </p>

            <div class="mt-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-[#E6B64C]">Escopo de atuação</h3>
              <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-[#ECEDE9]/80">
                {service.sections.slice(0, 6).map((sec) => (
                  <li class="flex items-center gap-2">
                    <span class="h-1.5 w-1.5 rounded-full bg-[#E6B64C]"></span>
                    <span>{sec}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-8 flex items-center gap-4">
              <a href={withBase(`/servicos/${service.slug}/`)} class="btn-gold">
                Saiba mais →
              </a>
              <a href={withBase("/contato/")} class="btn-secondary-dark">
                Solicitar avaliação
              </a>
            </div>
          </div>

          <div class={`overflow-hidden rounded-lg h-[280px] sm:h-[340px] bg-[#001816] ${index % 2 === 1 ? "lg:order-1" : ""}`}>
            <img
              src={withBase(service.image)}
              alt={service.title}
              class="h-full w-full object-cover"
              loading="lazy"
              width="600"
              height="340"
            />
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="border-t border-white/10 bg-[#001816] py-16 text-white text-center">
    <div class="cx-shell max-w-3xl">
      <h2 class="font-serif-display text-2xl sm:text-3xl text-white">
        Precisa de suporte técnico especializado?
      </h2>
      <p class="mt-3 text-sm text-[#D8D8D5]">
        Converse diretamente com os engenheiros da Conexium e avalie a viabilidade técnica da sua demanda.
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a href={withBase("/contato/")} class="btn-gold">
          Solicitar diagnóstico →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
