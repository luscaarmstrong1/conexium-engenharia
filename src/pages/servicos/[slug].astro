---
import BaseLayout from "@layouts/BaseLayout.astro";
import { servicePages, site } from "@data/site";
import { absoluteUrl, withBase } from "@lib/urls";

export function getStaticPaths() {
  return servicePages.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const path = `/servicos/${service.slug}/`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: site.url },
    { "@type": "ListItem", position: 2, name: "Serviços", item: absoluteUrl("/servicos/") },
    { "@type": "ListItem", position: 3, name: service.title, item: absoluteUrl(path) },
  ],
};
---

<BaseLayout
  title={`${service.title} | Conexium Engenharia`}
  description={service.description}
  path={path}
  jsonLd={breadcrumbJsonLd}
>
  <!-- Hero Section -->
  <section class="border-b border-white/10 bg-[#001816] py-20 text-white">
    <div class="cx-shell">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-xs font-bold tracking-[0.2em] text-[#E6B64C] uppercase">
            {service.eyebrow}
          </p>
          <h1 class="font-serif-display mt-4 text-[clamp(2.2rem,3.4vw,3.2rem)] leading-tight text-white">
            {service.title}
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-[#D8D8D5]/90">
            {service.description}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={withBase("/contato/")} class="btn-gold">
              Solicitar diagnóstico →
            </a>
            <a href={withBase("/servicos/")} class="btn-secondary-dark">
              Ver todos os serviços
            </a>
          </div>
        </div>

        <div class="h-[300px] sm:h-[380px] overflow-hidden rounded-xl bg-[#001D1B] shadow-xl">
          <img
            src={withBase(service.image)}
            alt={service.title}
            class="h-full w-full object-cover"
            loading="eager"
            width="640"
            height="380"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Escopo e Atuação -->
  <section class="bg-[#FAF8F3] py-20 text-[#303735]">
    <div class="cx-shell">
      <div class="grid gap-12 lg:grid-cols-[40%_60%]">
        <div>
          <p class="text-xs font-bold tracking-[0.16em] text-[#D7A536] uppercase">
            ESCOPO DE ATUACAO
          </p>
          <h2 class="font-serif-display mt-3 text-2xl lg:text-3xl text-[#001816]">
            Atuação técnica especializada e fundamentada.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-[#303735]/85">
            Cada análise e estudo é desenvolvido com base em normas vigentes, evidências técnicas e responsabilidade profissional.
          </p>
          <div class="mt-6 rounded-lg border border-[#D8D8D5]/80 bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-[#001816]">Responsabilidade Técnica</p>
            <p class="mt-2 text-xs leading-relaxed text-[#303735]/80">
              {service.note}
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {service.scope.map((item) => (
            <div class="rounded-lg border border-[#D8D8D5]/60 bg-white p-5 shadow-sm">
              <div class="flex items-start gap-3">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-[#D7A536]"></span>
                <p class="text-xs font-medium leading-relaxed text-[#303735]">{item}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Quando Contratar & Entregáveis -->
  <section class="border-y border-white/10 bg-[#001D1B] py-20 text-white">
    <div class="cx-shell">
      <div class="grid gap-12 lg:grid-cols-2">
        <!-- Quando Contratar -->
        <div>
          <p class="text-xs font-bold tracking-[0.16em] text-[#E6B64C] uppercase">
            QUANDO CONTRATAR
          </p>
          <h2 class="font-serif-display mt-3 text-2xl text-white">
            Cenários típicos de acionamento
          </h2>
          <ul class="mt-6 space-y-3 text-sm text-[#D8D8D5]">
            {service.whenToHire.map((item) => (
              <li class="flex items-start gap-3 rounded-lg border border-white/5 bg-[#002320] p-4">
                <span class="mt-1 text-[#E6B64C]">✓</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Entregáveis -->
        <div>
          <p class="text-xs font-bold tracking-[0.16em] text-[#E6B64C] uppercase">
            ENTREGÁVEIS TÉCNICOS
          </p>
          <h2 class="font-serif-display mt-3 text-2xl text-white">
            Produtos documentais e relatórios
          </h2>
          <ul class="mt-6 space-y-3 text-sm text-[#D8D8D5]">
            {service.deliverables.map((item) => (
              <li class="flex items-start gap-3 rounded-lg border border-white/5 bg-[#002320] p-4">
                <span class="mt-1 text-[#E6B64C]">→</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Como Trabalhamos -->
  <section class="bg-[#001816] py-20 text-white">
    <div class="cx-shell">
      <div class="text-center max-w-2xl mx-auto">
        <p class="text-xs font-bold tracking-[0.16em] text-[#E6B64C] uppercase">
          COMO TRABALHAMOS
        </p>
        <h2 class="font-serif-display mt-3 text-2xl sm:text-3xl text-white">
          Metodologia e rigor técnico
        </h2>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {service.howWeWork.map((step, idx) => (
          <div class="rounded-lg border border-white/10 bg-[#002320] p-5">
            <span class="text-xs font-bold text-[#E6B64C]">0{idx + 1}</span>
            <p class="mt-3 text-xs leading-relaxed text-[#D8D8D5]">{step}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="border-t border-white/10 bg-[#001D1B] py-16 text-white text-center">
    <div class="cx-shell max-w-3xl">
      <h2 class="font-serif-display text-2xl sm:text-3xl text-white">
        Submeta sua demanda para avaliação técnica
      </h2>
      <p class="mt-3 text-sm text-[#D8D8D5]">
        Nossa equipe de engenharia elétrica retornará com uma leitura inicial objetiva.
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a href={withBase("/contato/")} class="btn-gold">
          Solicitar diagnóstico →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
