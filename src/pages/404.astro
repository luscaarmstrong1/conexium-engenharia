---
import BaseLayout from "@layouts/BaseLayout.astro";
import { withBase } from "@lib/urls";
---

<BaseLayout title="Página não encontrada | Conexium Engenharia" description="A página solicitada não foi encontrada." path="/404/">
  <section class="min-h-[70vh] flex items-center bg-[#001816] py-24 text-white">
    <div class="cx-shell max-w-2xl text-center">
      <p class="text-sm font-bold tracking-[0.2em] text-[#E6B64C] uppercase">ERRO 404</p>
      <h1 class="font-serif-display mt-4 text-4xl sm:text-5xl text-white">Página não encontrada</h1>
      <p class="mt-4 text-sm leading-relaxed text-[#D8D8D5]">
        O endereço solicitado não existe ou foi reorganizado no novo site da Conexium Engenharia.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a href={withBase("/")} class="btn-gold">
          Voltar ao início →
        </a>
        <a href={withBase("/servicos/")} class="btn-secondary-dark">
          Ver serviços
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
