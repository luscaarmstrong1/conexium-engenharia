---
import BaseLayout from "@layouts/BaseLayout.astro";
import { servicePages, methodologySteps, whenCanHelpItems, site } from "@data/site";
import { withBase } from "@lib/urls";

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Conexium Engenharia | Engenharia Elétrica, Regulação e Perícias Técnicas",
  description: site.description,
  url: site.url,
};
---

<BaseLayout
  title="Conexium Engenharia | Engenharia Elétrica, Regulação e Perícias Técnicas"
  description={site.description}
  path="/"
  jsonLd={homeJsonLd}
>
  <!-- =========================================================================
       HERO SECTION (Visualmente 1:1 com o Mockup)
       Desktop: 47% texto / 53% imagem, transição escura suave, engenheiro de costas
       ========================================================================= -->
  <section class="relative isolate overflow-hidden bg-[#001816] text-white">
    <div class="cx-shell relative">
      <div class="grid items-center lg:grid-cols-[47%_53%] min-h-[580px] lg:min-h-[640px]">
        <!-- Lado Esquerdo: Conteúdo Editorial e CTAs -->
        <div class="z-10 py-12 lg:py-16 pr-0 lg:pr-8">
          <p class="text-xs font-bold tracking-[0.22em] text-[#E6B64C] uppercase">
            ENGENHARIA. REGULACAO. EVIDÊNCIA.
          </p>

          <h1 class="font-serif-display mt-5 text-[clamp(2.1rem,3.4vw,3.3rem)] leading-[1.12] text-[#FFFFFF]">
            Engenharia elétrica,<br />
            consultoria técnico-regulatória<br />
            e evidência técnica para<br />
            <span class="text-[#E6B64C]">decisões seguras.</span>
          </h1>

          <p class="mt-6 max-w-xl text-[0.95rem] leading-[1.65] text-[#D8D8D5]/90">
            Soluções técnicas e estratégicas em engenharia, regulação e análise técnica com base em evidências, para apoiar projetos, operações e decisões no setor elétrico.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={withBase("/contato/")} class="btn-gold" data-track="hero-cta-primary">
              Solicitar diagnóstico <span class="ml-1.5" aria-hidden="true">→</span>
            </a>
            <a href={withBase("/contato/")} class="btn-secondary-dark" data-track="hero-cta-secondary">
              Falar com um especialista
            </a>
          </div>
        </div>

        <!-- Lado Direito: Fotografia do Engenheiro com transição suave -->
        <div class="relative h-[380px] sm:h-[480px] lg:h-full lg:min-h-[640px] w-full overflow-hidden">
          <img
            src={withBase("/assets/conexium/hero-subestacao-engenheiro.png")}
            alt="Engenheiro eletricista analisando diagrama em notebook diante de subestação ao pôr do sol"
            class="h-full w-full object-cover object-center lg:object-[65%_center]"
            loading="eager"
            fetchpriority="high"
            width="1280"
            height="720"
          />
          <!-- Gradiente de transição escura suave para fundir perfeitamente com a coluna de texto -->
          <div class="absolute inset-y-0 left-0 hidden w-32 bg-gradient-to-r from-[#001816] to-transparent lg:block" aria-hidden="true"></div>
          <!-- Gradiente inferior sutil para mobile -->
          <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#001816] to-transparent lg:hidden" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       TRUST BAR ABAIXO DO HERO
       Faixa horizontal verde petróleo profundo com 4 pilares e divisores discretos
       ========================================================================= -->
  <section class="border-y border-white/10 bg-[#001D1B] py-6 text-white" aria-label="Garantias técnicas">
    <div class="cx-shell">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-white/10">
        <!-- Benefício 1: Metodologia rastreável -->
        <div class="flex items-center gap-4 px-2">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#E6B64C]/30 bg-[#E6B64C]/10 text-[#E6B64C]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
          </div>
          <div>
            <h2 class="text-sm font-semibold text-white">Metodologia rastreável</h2>
            <p class="mt-0.5 text-xs text-[#8D9592]">Análises técnicas com base normativa</p>
          </div>
        </div>

        <!-- Benefício 2: Responsabilidade técnica -->
        <div class="flex items-center gap-4 px-2 lg:pl-6">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#E6B64C]/30 bg-[#E6B64C]/10 text-[#E6B64C]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
          </div>
          <div>
            <h2 class="text-sm font-semibold text-white">Responsabilidade técnica</h2>
            <p class="mt-0.5 text-xs text-[#8D9592]">ART em todos os trabalhos</p>
          </div>
        </div>

        <!-- Benefício 3: Atuação técnica especializada -->
        <div class="flex items-center gap-4 px-2 lg:pl-6">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#E6B64C]/30 bg-[#E6B64C]/10 text-[#E6B64C]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <div>
            <h2 class="text-sm font-semibold text-white">Atuação técnica especializada</h2>
            <p class="mt-0.5 text-xs text-[#8D9592]">Setor elétrico e regulação</p>
          </div>
        </div>

        <!-- Benefício 4: Conformidade normativa -->
        <div class="flex items-center gap-4 px-2 lg:pl-6">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#E6B64C]/30 bg-[#E6B64C]/10 text-[#E6B64C]" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <div>
            <h2 class="text-sm font-semibold text-white">Conformidade normativa</h2>
            <p class="mt-0.5 text-xs text-[#8D9592]">ANEEL, ABNT, ONS, IEC e outras</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECAO SOBRE A CONEXIUM
       Fundo off-white, texto editorial à esquerda, foto de análise com badge escuro à direita
       ========================================================================= -->
  <section class="bg-[#FAF8F3] py-20 lg:py-24 text-[#303735]" aria-labelledby="sobre-title">
    <div class="cx-shell">
      <div class="grid items-center gap-12 lg:grid-cols-[45%_55%]">
        <!-- Coluna Esquerda: Texto institucional -->
        <div>
          <p class="text-xs font-bold tracking-[0.2em] text-[#D7A536] uppercase">
            SOBRE A CONEXIUM
          </p>

          <h2 id="sobre-title" class="font-serif-display mt-4 text-[clamp(2rem,3vw,2.75rem)] leading-[1.18] text-[#001816]">
            Engenharia, regulação<br />
            e evidência a serviço<br />
            de decisões técnicas.
          </h2>

          <div class="mt-6 space-y-4 text-[0.95rem] leading-[1.75] text-[#303735]/85">
            <p>
              A Conexium Engenharia atua com soluções técnicas para o setor elétrico, unindo conhecimento de engenharia, análise regulatória e produção de evidências técnicas.
            </p>
            <p>
              Nosso trabalho apoia projetos, decisões, contestações, processos regulatórios e demandas que exigem fundamentação, rastreabilidade e responsabilidade técnica.
            </p>
          </div>

          <div class="mt-8">
            <a href={withBase("/a-conexium/")} class="btn-gold" data-track="sobre-cta">
              Conheça a Conexium <span class="ml-1.5" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Coluna Direita: Foto com composição de badge técnico sobreposto -->
        <div class="relative overflow-hidden rounded-xl shadow-[0_16px_40px_rgba(0,24,22,0.12)]">
          <div class="relative h-[360px] sm:h-[420px] w-full">
            <img
              src={withBase("/assets/conexium/analise-projeto-mesa.png")}
              alt="Engenheiro examinando desenho elétrico sobre mesa com capacete de segurança"
              class="h-full w-full object-cover object-center"
              loading="lazy"
              width="900"
              height="600"
            />
            <!-- Composição lateral escura conforme Mockup com HTML real -->
            <div class="absolute inset-y-0 right-0 flex w-[42%] flex-col justify-center bg-[#001D1B]/95 p-6 sm:p-8 text-white backdrop-blur-sm">
              <div class="mb-4">
                <img src={withBase("/brand/conexium-symbol.svg")} alt="" class="h-8 w-8" width="32" height="32" />
              </div>
              <div class="border-l-2 border-[#E6B64C] pl-4">
                <p class="text-xs sm:text-sm font-bold tracking-[0.14em] text-white leading-relaxed uppercase">
                  BASE TÉCNICA<br />
                  PARA PROJETOS,<br />
                  DISPUTAS E<br />
                  DECISÕES<br />
                  ESTRATÉGICAS.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECAO PRINCIPAL DE SERVIÇOS (EXATAMENTE TRÊS CARDS)
       Fundo verde petróleo profundo (#001816), cards técnicos com imagens reais
       ========================================================================= -->
  <section class="bg-[#001816] py-20 lg:py-24 text-white" aria-labelledby="servicos-title">
    <div class="cx-shell">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="text-xs font-bold tracking-[0.2em] text-[#E6B64C] uppercase">
            NOSSOS SERVIÇOS
          </p>
          <h2 id="servicos-title" class="font-serif-display mt-3 text-[clamp(1.9rem,2.8vw,2.5rem)] text-white">
            Soluções técnicas para o setor elétrico
          </h2>
        </div>
        <p class="max-w-md text-sm text-[#8D9592]">
          Projetos, análises e pareceres com rigor técnico, visão regulatória e foco em resultados.
        </p>
      </div>

      <!-- Grid com exatamente 3 Cards -->
      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {servicePages.map((service, index) => (
          <article class="cx-service-card flex flex-col">
            <!-- Imagem de topo do card -->
            <div class="relative h-48 w-full overflow-hidden bg-[#001D1B]">
              <img
                src={withBase(service.image)}
                alt={service.title}
                class="h-full w-full object-cover transition duration-300 hover:scale-[1.02]"
                loading="lazy"
                width="480"
                height="240"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#002320] via-transparent to-transparent opacity-80" aria-hidden="true"></div>
            </div>

            <!-- Conteúdo do card -->
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <!-- Ícone técnico em linha dourada -->
              <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg border border-[#E6B64C]/30 bg-[#E6B64C]/10 text-[#E6B64C]" aria-hidden="true">
                {index === 0 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                )}
                {index === 1 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                )}
                {index === 2 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                )}
              </div>

              <h3 class="text-xl font-bold text-white leading-snug">
                {service.title}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-[#D8D8D5]/80">
                {service.cardDescription}
              </p>

              <!-- Bullets com check dourado -->
              <ul class="mt-5 space-y-2.5 text-xs text-[#ECEDE9]/90">
                {service.cardBullets.map((bullet) => (
                  <li class="flex items-center gap-2.5">
                    <svg class="h-4 w-4 shrink-0 text-[#E6B64C]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- CTA Saiba mais -->
              <div class="mt-auto pt-6">
                <a
                  href={withBase(`/servicos/${service.slug}/`)}
                  class="inline-flex items-center text-sm font-semibold text-[#E6B64C] transition hover:text-[#F0C767]"
                >
                  Saiba mais <span class="ml-1.5" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECAO "QUANDO PODEMOS AJUDAR"
       Fundo claro, 4 colunas com ícones técnicos minimalistas
       ========================================================================= -->
  <section class="bg-[#FAF8F3] py-20 text-[#303735]" aria-labelledby="quando-ajudar-title">
    <div class="cx-shell">
      <div class="grid items-center gap-8 lg:grid-cols-[30%_70%]">
        <div>
          <h2 id="quando-ajudar-title" class="font-serif-display text-[clamp(1.8rem,2.5vw,2.3rem)] text-[#001816]">
            Quando podemos ajudar
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[#303735]/80">
            Apoiamos nossos clientes em diferentes momentos, com soluções técnicas objetivas e fundamentadas.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {whenCanHelpItems.map((item, idx) => (
            <div class="rounded-lg border border-[#D8D8D5]/60 bg-white p-5 shadow-sm">
              <div class="mb-3 text-[#D7A536]" aria-hidden="true">
                {idx === 0 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="m19 9-5 5-4-4-3 3"></path></svg>
                )}
                {idx === 1 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                )}
                {idx === 2 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"></path><path d="M7 21h10"></path><path d="M12 3v18"></path><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"></path></svg>
                )}
                {idx === 3 && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                )}
              </div>
              <h3 class="text-xs font-bold uppercase tracking-wider text-[#001816]">
                {item.title}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[#303735]/80">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       METODOLOGIA
       Fundo verde muito escuro (#001816), linha horizontal dourada, números nos círculos
       ========================================================================= -->
  <section class="border-y border-white/10 bg-[#001816] py-20 text-white" aria-labelledby="metodologia-title">
    <div class="cx-shell">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <h2 id="metodologia-title" class="font-serif-display text-[clamp(1.9rem,2.8vw,2.5rem)] text-white">
            Nossa metodologia
          </h2>
          <p class="mt-2 text-sm text-[#8D9592]">
            Da demanda à solução, com rastreabilidade, rigor técnico e foco em resultados.
          </p>
        </div>
        <a href={withBase("/a-conexium/")} class="btn-gold self-start md:self-auto">
          Conheça nossa metodologia →
        </a>
      </div>

      <!-- Timeline Desktop horizontal / Mobile vertical -->
      <div class="relative mt-16">
        <!-- Linha horizontal conectando os passos (apenas desktop) -->
        <div class="absolute left-0 top-4 hidden h-[2px] w-full bg-[#E6B64C]/40 md:block" aria-hidden="true"></div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
          {methodologySteps.map((step) => (
            <div class="relative flex flex-col items-start">
              <!-- Círculo com o número do passo -->
              <div class="z-10 flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#E6B64C] bg-[#001816] text-xs font-bold text-[#E6B64C] shadow-sm">
                {step.step}
              </div>
              <h3 class="mt-4 text-base font-bold text-white">
                {step.title}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[#8D9592]">
                {step.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       CTA FINAL (Visualmente 1:1 com o Mockup)
       Arte das linhas de transmissão ao pôr do sol, overlay escuro, textos em HTML
       ========================================================================= -->
